rules_version = '2';
// Himachal Farm Direct — security rules.
// Customers' exact locations/addresses are readable ONLY by their owner (and, per order,
// by the farmer fulfilling it). Approval, roles, ticket numbers, order totals and stock
// deductions are set by Cloud Functions, never trusted from the client.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Admins: anyone given the `admin` custom claim, plus the owner's Google account.
    function isAdmin() {
      return signedIn() && (request.auth.token.admin == true
        || (request.auth.token.email_verified == true
            && request.auth.token.email in ['dharmenderk950@gmail.com']));
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function approvedSeller() {
      return signedIn() && get(/databases/$(database)/documents/farmers/$(request.auth.uid)).data.approved == true;
    }

    // ---------------- users (private)
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['isAdmin', 'sellerStatus']);
      allow update: if isAdmin() || (isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'sellerStatus']));

      match /addresses/{id} {
        allow read, write: if isOwner(uid);
      }
      match /wishlist/{id} {
        allow read, write: if isOwner(uid);
      }
      match /notifications/{id} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin();
        allow update: if isOwner(uid) && onlyChanges(['read', 'readAt']);
      }
    }

    // ---------------- farmers (public business profiles)
    match /farmers/{farmerId} {
      allow read: if resource.data.approved == true || isOwner(farmerId) || isAdmin();
      allow create: if isOwner(farmerId)
        && request.resource.data.approved == false
        && request.resource.data.featured == false
        && !request.resource.data.keys().hasAny(['rejected', 'rating']);
      allow update: if isAdmin() || (isOwner(farmerId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved', 'featured', 'rejected', 'rating']));
      allow delete: if isAdmin();
    }

    // ---------------- products
    match /products/{id} {
      allow read: if true;
      allow create: if approvedSeller() && request.resource.data.farmerId == request.auth.uid
        && request.resource.data.price is number && request.resource.data.price > 0
        && request.resource.data.stock is number && request.resource.data.stock >= 0
        && !request.resource.data.keys().hasAny(['soldCount']);
      allow update: if isAdmin() || (approvedSeller() && resource.data.farmerId == request.auth.uid
        && request.resource.data.farmerId == request.auth.uid
        && request.resource.data.stock is number && request.resource.data.stock >= 0);
      allow delete: if isAdmin() || (signedIn() && resource.data.farmerId == request.auth.uid);
    }

    // ---------------- orders
    // Buyers create orders as PLACED; the farmer confirms by accepting (stock deducted then).
    // With Cloud Functions deployed, the functions do this server-side instead.
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid
        || resource.data.farmerId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.farmerId is string
        && request.resource.data.farmerId != request.auth.uid
        && request.resource.data.status == 'PLACED'
        && request.resource.data.stockDeducted == false
        && request.resource.data.grandTotal is number;
      allow update: if isAdmin()
        || (signedIn() && resource.data.farmerId == request.auth.uid
            && onlyChanges(['status', 'updatedAt', 'stockDeducted'])
            && (
              (resource.data.status == 'PLACED' && request.resource.data.status in ['ACCEPTED', 'REJECTED'])
              || (resource.data.status == 'ACCEPTED' && request.resource.data.status in ['PACKED', 'CANCELLED'])
              || (resource.data.status == 'PACKED' && request.resource.data.status in ['OUT_FOR_DELIVERY', 'READY_FOR_PICKUP'])
              || (resource.data.status in ['OUT_FOR_DELIVERY', 'READY_FOR_PICKUP'] && request.resource.data.status == 'DELIVERED')
            ))
        || (signedIn() && resource.data.buyerId == request.auth.uid
            && onlyChanges(['status', 'updatedAt'])
            && resource.data.status == 'PLACED' && request.resource.data.status == 'CANCELLED');

      match /private/{doc} {
        allow read: if signedIn() && (resource.data.buyerId == request.auth.uid
          || resource.data.farmerId == request.auth.uid || isAdmin());
        allow write: if false;
      }
    }

    // ---------------- support tickets (created via function; admin replies)
    match /supportTickets/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'OPEN' && request.resource.data.adminReply == '';
      allow delete: if false;
    }

    // ---------------- public catalogue data, admin-managed
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /collectionCentres/{id} { allow read: if true; allow write: if isAdmin(); }
    match /config/{id} { allow read: if id == 'delivery' || isAdmin(); allow write: if isAdmin(); }
    match /counters/{id} { allow read, write: if false; }
    match /mail/{id} { allow read, write: if false; }
  }
}
